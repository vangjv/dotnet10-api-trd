<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>Company.Product.Service.Api</AssemblyName>
    <RootNamespace>Company.Product.Service.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <UserSecretsId>Company.Product.Service.Api.Reference</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Company.Product.Service.Application\Company.Product.Service.Application.csproj" />
    <ProjectReference Include="..\Company.Product.Service.Infrastructure\Company.Product.Service.Infrastructure.csproj" />
    <InternalsVisibleTo Include="Company.Product.Service.Tests.Integration" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Datadog.Trace.Bundle" Version="3.50.0" Condition="'$(IncludeDatadogProfiler)' == 'true'" />
  </ItemGroup>
</Project>
