{
  "ApiKey": {
    "HeaderName": "X-Api-Key",
    "Keys": [ "REPLACE_VIA_AWS_SECRETS_MANAGER" ]
  },
  "ConnectionStrings": {
    "Default": "Server=(local);Database=AppDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
